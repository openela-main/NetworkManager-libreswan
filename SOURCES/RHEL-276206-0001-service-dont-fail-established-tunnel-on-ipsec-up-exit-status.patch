From ea5b243af26d649b28e5447d1aae58b25b8a3711 Mon Sep 17 00:00:00 2001
From: Josephine Pfeiffer <josie@redhat.com>
Date: Wed, 2 Sep 2026 17:13:52 +0200
Subject: [PATCH] service: don't fail an established tunnel on ipsec up exit
 status

Once pluto runs the "up" verb the tunnel exists and its configuration
has reached NetworkManager, so a non-zero status from "ipsec up" after
that must not tear it down. The helper runs for prepare, route, down and
unroute too and each sends a configuration, so the guard keys on the verb.

Libreswan 5.4 relays EXPECTATION FAILED warnings to whack with
RC_INTERNAL_ERROR, and whack latches the first as its exit code, so
"ipsec up" exits 52 over a working tunnel. 5.3 logged them against the
global logger, which has no whack fd; a leftprotoport profile trips one
on every activation.

Resolves: https://issues.redhat.com/browse/RHEL-252995
Signed-off-by: Josephine Pfeiffer <josie@redhat.com>
---
 src/nm-libreswan-service.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/nm-libreswan-service.c b/src/nm-libreswan-service.c
index acbd078..e9530b3 100644
--- a/src/nm-libreswan-service.c
+++ b/src/nm-libreswan-service.c
@@ -110,6 +110,7 @@ typedef struct {
 	gboolean pending_auth;
 	gboolean managed;
 	gboolean xauth_enabled;
+	gboolean tunnel_up;
 
 	GPid pid;
 	guint watch_id;
@@ -254,6 +255,7 @@ connect_cleanup(NMLibreswanPlugin *self)
 
 	priv->connect_step = CONNECT_STEP_FIRST;
 	priv->pending_auth = FALSE;
+	priv->tunnel_up = FALSE;
 
 	/* Don't remove the child watch since it needs to reap the child */
 	priv->watch_id = 0;
@@ -408,7 +410,13 @@ child_watch_cb(GPid pid, gint status, gpointer user_data)
 	 * libreswan versions. */
 	if (priv->connect_step == CONNECT_STEP_WAIT_READY)
 		success = (ret != 1);
-	else
+	else if (priv->connect_step == CONNECT_STEP_CONNECT && priv->tunnel_up) {
+		/* Libreswan reports a non-zero status over a working tunnel: 5.4 relays
+		 * its internal consistency warnings as RC_INTERNAL_ERROR. */
+		if (ret != 0)
+			_LOGI("ignoring status %d from connect: tunnel is up", ret);
+		success = TRUE;
+	} else
 		success = (ret == 0);
 
 	/* Ignore failures here, maybe the libreswan daemon is too old. */
@@ -1562,6 +1570,11 @@ handle_callback(NMDBusLibreswanHelper *object,
 	nm_vpn_service_plugin_set_config(NM_VPN_SERVICE_PLUGIN(user_data), variant);
 	g_variant_unref(variant);
 
+	/* Pluto runs this verb once the tunnel is up. The other verbs deliver a
+	 * configuration too, before there is a tunnel to carry it. */
+	if (g_str_has_prefix(verb, "up-"))
+		priv->tunnel_up = TRUE;
+
 	if (has_ip_config[0]) {
 		variant = g_variant_builder_end(&ip4_config);
 		_LOGD("sending IP4 config: %s", (str = g_variant_print(variant, FALSE)));
-- 
